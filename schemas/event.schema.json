{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event",
  "description": "A single event in a day file",
  "type": "object",
  "required": ["seq", "ts", "type", "order_id", "lines"],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1,
      "description": "Sequence number (1..N, contiguous)"
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 43200,
      "description": "Seconds since opening (non-decreasing)"
    },
    "type": {
      "type": "string",
      "enum": ["walk_in", "online"],
      "description": "Event type"
    },
    "order_id": {
      "type": "string",
      "description": "Unique order identifier within the day"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "description": "Order lines (1-6, distinct item_ids)",
      "items": {
        "type": "object",
        "required": ["item_id", "qty"],
        "properties": {
          "item_id": { "type": "string" },
          "qty": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
